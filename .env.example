# Frontend Environment Variables — copy to .env and fill in your keys (never commit .env)

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5001/api

# Clerk Auth
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: override analytics endpoint (defaults to <VITE_API_BASE_URL>/analytics/events)
# VITE_ANALYTICS_ENDPOINT=https://your-backend/api/analytics/events

# AI and LinkedIn import run on the backend, so no provider keys belong in this file.
# Anything prefixed VITE_ is shipped to the browser and is public.
