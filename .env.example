# Frontend Environment Variables — copy to .env and fill in your keys (never commit .env)

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5001/api

# Clerk Auth
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# RapidAPI — LinkedIn Profile Imports
VITE_RAPIDAPI_KEY=...

# Optional: override analytics endpoint (defaults to <VITE_API_BASE_URL>/analytics/events)
# VITE_ANALYTICS_ENDPOINT=https://your-backend/api/analytics/events

# Note: AI is now handled via backend OpenRouter (OPENROUTER_API_KEY in Backend_Resume-main/.env)
# No VITE_NVIDIA_API_KEY needed in frontend. Legacy kept for fallback:
# VITE_NVIDIA_API_KEY=nvapi-...
# VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# VITE_AI_MODEL=deepseek/deepseek-chat
